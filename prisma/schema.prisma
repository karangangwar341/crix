generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Admin & Audit
// ---------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activity AdminActivity[]
}

model AdminActivity {
  id          String   @id @default(cuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id])
  action      String
  entityType  String?
  entityId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Media Library (Integrated with Neon Object Storage / S3)
// ---------------------------------------------------------------------------

model Media {
  id           String   @id @default(cuid())
  url          String
  thumbnailUrl String?
  fileName     String
  mimeType     String
  fileSize     Int
  width        Int?
  height       Int?
  altText      String?
  title        String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usages MediaUsage[]

  @@index([createdAt])
}

model MediaUsage {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  ownerType String   // "PRODUCT" | "CATEGORY" | "HOMEPAGE" | "CRAFT"
  ownerId   String
  role      String   // "HERO" | "THUMBNAIL" | "GALLERY" | "STICKER" | "BANNER"
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([mediaId])
  @@index([ownerType, ownerId])
}

// ---------------------------------------------------------------------------
// CMS: Site Settings & Modular Homepage Sections
// ---------------------------------------------------------------------------

model SiteSettings {
  id                    String   @id @default("singleton")
  businessName          String   @default("CRIX Cricket & Sports")
  phone                 String   @default("+44 20 7946 0912")
  whatsapp              String   @default("442079460912")
  email                 String   @default("support@crixcricket.com")
  address               String?  @default("The Pavilion, St. John's Wood, London")
  instagramUrl          String?  @default("https://instagram.com/crixcricket")
  facebookUrl           String?  @default("https://facebook.com/crixcricket")
  youtubeUrl            String?  @default("https://youtube.com/@crixcricket")
  defaultSeoTitle       String   @default("CRIX | Professional Cricket Equipment & Accessories")
  defaultSeoDescription String   @default("Handcrafted English Willow bats, protective batting gear, luggage, and performance cricket accessories.")
  currency              String   @default("GBP")
  currencySymbol        String   @default("£")
  updatedAt             DateTime @updatedAt
}

model CmsSection {
  id          String   @id // e.g. "hero", "bestseller", "craft", "categories_intro", "players"
  title       String?
  subtitle    String?
  eyebrow     String?
  content     String?  // Rich text or JSON payload
  metaData    String   @default("{}") // JSON string for structured fields (CTAs, IDs, links)
  published   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  category  String   @default("General") // "Bats", "Delivery", "Custom Orders", "General"
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// E-Commerce: Categories & Products
// ---------------------------------------------------------------------------

model Category {
  id          String    @id // "bats", "batting-gloves", "batting-pads", "helmets", "bags", "accessories"
  name        String
  tagline     String
  description String
  heroSeed    String?
  imageUrl    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  series           String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  subcategory      String?
  price            Float
  compareAtPrice   Float?
  description      String
  shortDescription String
  stock            Int      @default(0)
  rating           Float    @default(5.0)
  reviewCount      Int      @default(0)
  badges           String   @default("[]") // JSON string array e.g. ["Bestseller", "Signature"]
  featured         Boolean  @default(false)
  bestseller       Boolean  @default(false)
  isNew            Boolean  @default(false)

  // Visual tones (for bat generation and UI)
  willowTone       String?  @default("#ead9ad")
  accentTone       String?  @default("#8a1f2b")

  // Bat Specifications (stored as structured JSON string for flexibility)
  specifications   String?  // JSON string BatSpecifications

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants         ProductVariant[]
  images           ProductMedia[]
  reviews          Review[]
  orderItems       OrderItem[]
  analyticsEvents  AnalyticsEvent[]

  @@index([categoryId])
  @@index([featured])
  @@index([bestseller])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  angle     String   // "front", "back", "left", "toe", "spine", "sticker", etc.
  url       String?  // Actual uploaded file or S3 URL
  seed      String?  // Fallback generative seed
  order     Int      @default(0)

  @@index([productId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String   // e.g. "2.9 lb", "Size 5", "Adult"
  priceDelta Float    @default(0)
  stock      Int      @default(10)
  inStock    Boolean  @default(true)

  orderItems OrderItem[]

  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author     String
  verified   Boolean  @default(true)
  rating     Int      @default(5)
  title      String
  body       String
  tags       String   @default("[]") // JSON string array
  isSample   Boolean  @default(false)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId])
  @@index([published])
}

// ---------------------------------------------------------------------------
// CRM: Customers, Orders & Business Enquiries
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  passwordHash String?
  phone       String?
  address     String?
  notes       String?
  totalSpent  Float    @default(0)
  ordersCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([email])
}

model Order {
  id              String      @id // e.g. "CRIX-10245"
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String?
  totalAmount     Float
  status          String      @default("Pending") // "Pending" | "Processing" | "Fulfilled" | "Refunded" | "Cancelled"
  paymentStatus   String      @default("Paid")    // "Pending" | "Paid" | "Failed" | "Refunded"
  paymentMethod   String      @default("Card")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  title     String
  quantity  Int             @default(1)
  unitPrice Float
  total     Float

  @@index([orderId])
}

model Enquiry {
  id          String   @id @default(cuid())
  company     String
  contact     String
  email       String?
  phone       String?
  category    String   // "Bulk Orders" | "Custom Manufacturing" | "Private Label" | "Corporate Programs"
  quantity    String
  message     String?
  status      String   @default("New") // "New" | "In Review" | "Quoted" | "Closed"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Analytics: Real-time Event Tracking
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String   // "page_view" | "product_view" | "add_to_cart" | "checkout_start" | "purchase"
  path       String
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  sessionId  String
  device     String?  // "mobile" | "desktop" | "tablet"
  referrer   String?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}
