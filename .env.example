# -----------------------------------------------------------------------------
# CRIX — Professional Cricket Ecommerce & Equipment Platform
# Environment Configuration Example
# -----------------------------------------------------------------------------

# Database — PostgreSQL (e.g. Neon Serverless, Supabase, or Local Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-random-secret-key-change-this"

# Admin Initial Credentials (used by prisma/seed.ts)
ADMIN_NAME="CRIX Admin"
ADMIN_EMAIL="admin@crixcricket.com"
ADMIN_PASSWORD="crix_admin_secure_2026"

# Neon Object Storage / AWS S3 Compatible Storage (for product photo uploads)
AWS_ENDPOINT_URL_S3="https://your-storage-endpoint.storage.c-4.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="your-s3-access-key-id"
AWS_SECRET_ACCESS_KEY="your-s3-secret-access-key"
AWS_REGION="us-east-2"
AWS_S3_BUCKET_NAME="crix-sport-accessories"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

